# Keep the build context small and the image reproducible. Without this,
# `docker build` ships .git, the host .venv (wrong platform), and every previous
# run's .zarr output into the daemon on each build.

.git
.gitignore
.github
.venv
__pycache__
**/__pycache__
*.pyc
*.egg-info
**/*.egg-info

# Solver output -- regenerated by the Job, never an input to the image.
runs
unused.zarr
prototypes/results

# Test/lint/bench caches
.pytest_cache
.mypy_cache
.ruff_cache
.hypothesis
.benchmarks

# Not runtime inputs: tests need the [dev] extra (quimb) that the image omits,
# and prototypes/ is tier-2 parity scratch.
tests
prototypes
tools
docs
*.md
# ...except LICENSE.md: pyproject declares `license-files = ["LICENSE.md"]`, so
# setuptools fails the wheel build outright if it is not in the context.
!LICENSE.md
.claude

# Editor/OS noise
.DS_Store
.idea
.vscode
